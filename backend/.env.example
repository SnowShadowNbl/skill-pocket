# 数据库：本地默认 SQLite（data/skillhub.db），生产填 PostgreSQL
# DATABASE_URL=postgresql+psycopg://skillhub:password@127.0.0.1:5432/skillhub

# 管理员密码哈希：运行 python -m app.cli set-password 自动写入，不要填明文
ADMIN_PASSWORD_HASH=
SECRET_KEY=
ADMIN_SESSION_MINUTES=30

# GitHub Personal Access Token（不填也能用，但每小时只有 60 次请求）
GITHUB_TOKEN=

# AI 接口（OpenAI 兼容协议）。不填则用规则兜底提炼
# 例：AI_BASE_URL=https://api.deepseek.com/v1   AI_TEXT_MODEL=deepseek-flash（支持图片输入）
AI_BASE_URL=
AI_API_KEY=
AI_TEXT_MODEL=

CORS_ORIGINS=http://localhost:5173

# ---- 自动采集 ----
CRAWL_ENABLED=true
CRAWL_TZ=Asia/Shanghai
# 工作窗口（额度用完会等下一小时重置，到结束时刻没跑完的留到第二天）
CRAWL_START=00:05
CRAWL_END=08:00
RANK_TOP_N=10
MAX_NEW_REPOS_PER_RUN=60
# 额外的 awesome 清单仓库，逗号分隔，如 VoltAgent/awesome-agent-skills
AWESOME_LISTS=

# ---- 语音评论（FunASR 2pass 流式）----
# 本地调试可先跑 python scripts/mock_asr.py，再填 ws://127.0.0.1:10095
FUNASR_WS_URL=

# ---- 微信小程序登录（小程序后台 → 开发管理 → 开发设置）----
WX_APPID=
WX_SECRET=
# 网页扫码用的小程序码打开哪个版本：release / trial / develop
WX_QR_ENV=release
