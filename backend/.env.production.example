# Skill Pocket 生产环境配置：复制为 backend/.env.production 后填写。
# 每一项的作用和申请方式见 docs/配置说明.md。不要把填好的文件提交到 Git。
# DATABASE_URL / FUNASR_WS_URL 由 docker-compose 注入，这里不用填。

# ---- 必填 ----
# 随机长字符串，用于签名登录会话：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=
# 实际访问域名（多个用逗号分隔）
CORS_ORIGINS=https://YOUR_DOMAIN
# 管理员密码哈希。推荐留空，部署后用「首次登录」在页面上设置（见 docs/部署指南.md）
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_MINUTES=30

# ---- AI 模型（OpenAI 兼容接口；不填时用规则代替，提炼和判断效果较差）----
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_TEXT_MODEL=qwen-plus

# ---- 语义搜索 Embedding（OpenAI 兼容接口；不填时只用关键词搜索）----
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# ---- GitHub（抓取仓库信息、每日采集；不填也能用，但很容易被限流）----
GITHUB_TOKEN=

# ---- 腾讯云邮件推送 SES（邮箱验证码登录；不填就无法用邮箱登录）----
SES_SECRET_ID=
SES_SECRET_KEY=
SES_REGION=ap-guangzhou
# 发信地址，须是在 SES 里验证过的域名下的地址，例如 noreply@mail.YOUR_DOMAIN
SES_FROM=
# 验证码邮件模板 ID（模板里用变量 {{code}}）
SES_TEMPLATE_ID=0
# 本地开发用：接口直接返回验证码。生产环境必须是 false
AUTH_DEV_CODES=false

# ---- 每日自动采集 ----
CRAWL_ENABLED=true
CRAWL_TZ=Asia/Shanghai
CRAWL_START=00:05
CRAWL_END=08:00
RANK_TOP_N=10
MAX_NEW_REPOS_PER_RUN=60
SKILL_SPLIT_MAX=15
AWESOME_LISTS=

# ---- 可选 ----
# 页脚「联系站长」邮箱；留空不显示
CONTACT_EMAIL=
# 微信小程序登录与网页微信扫码登录（需要你自己的微信小程序）；留空则只用邮箱登录
WX_APPID=
WX_SECRET=
# 网页扫码打开的小程序版本：release 正式版 / trial 体验版 / develop 开发版
WX_QR_ENV=release
